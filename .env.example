# Copy this file to .env and fill in your values. Never commit .env.

# Which provider to use: "anthropic" (default), "azure" or "openai".
LLM_PROVIDER=anthropic

# --- Anthropic Claude (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=<your-anthropic-key>
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Azure OpenAI (LLM_PROVIDER=azure) ---
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<your-azure-openai-key>
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# The Responses API needs 2025-03-01-preview or later.
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Standard OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=<your-openai-key>
# OPENAI_MODEL=gpt-5-mini

# Reasoning effort per agent (Azure and OpenAI only; Claude runs without thinking):
# none, minimal, low, medium or high. The retriever only picks keywords and filters
# chunks, so it can run lighter. gpt-5-mini supports minimal; newer models use none.
# RETRIEVER_REASONING_EFFORT=minimal
# GENERATOR_REASONING_EFFORT=low
